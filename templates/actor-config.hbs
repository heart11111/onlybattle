<section class="onlybattle-actor-config-body">
  <p class="notes">{{localize "ONLYBATTLE.ActorConfig.Help" actor=actorName}}</p>

  <div class="onlybattle-actor-config-fields">
    {{#each fields}}
      <label data-image-field>
        <span>{{localize label}}</span>
        <div class="onlybattle-actor-config-path">
          <input type="text" data-image-path="{{key}}" value="{{path}}" placeholder="path/to/image-or-video.webm" />
          <button type="button" data-action="browse"><i class="fa-solid fa-folder-open"></i></button>
          <button type="button" data-action="clear"><i class="fa-solid fa-xmark"></i></button>
        </div>
      </label>
    {{/each}}
  </div>

  <footer class="onlybattle-actions">
    <button type="button" data-action="save" class="default">
      <i class="fa-solid fa-save"></i>
      {{localize "Save"}}
    </button>
  </footer>
</section>
